# Public site origin (canonical, OG, sitemap) — never put secrets in NEXT_PUBLIC_*
NEXT_PUBLIC_SITE_URL=https://sparehand.vercel.app

# Optional server-side OpenAI fallback (prefer BYOK in Settings for demos)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# Inbound Zapier/Make webhook — send as header x-sparehand-secret
SPAREHAND_WEBHOOK_SECRET=dev-secret-change-me

# Reserved for hired Supabase builds (not used by the localStorage demo runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
